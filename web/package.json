{
  "name": "filinglens-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.7.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "next build",
    "start": "node scripts/run.mjs start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"lib/*.test.ts\" \"scripts/*.test.mjs\"",
    "e2e": "playwright test",
    "screens": "playwright test -c playwright.screens.config.ts",
    "hash-password": "node scripts/hash-password.mjs",
    "session-secret": "node scripts/session-secret.mjs",
    "postinstall": "npm --prefix ../clients/ts ci --omit=dev --ignore-scripts --no-audit --no-fund"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@shadergradient/react": "2.4.20",
    "motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
