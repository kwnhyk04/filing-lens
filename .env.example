# Copy to .env (git ignores it) and change every password and key.
# docker compose and `uv run --env-file .env` both read this file (see Makefile).
# Use URL-safe characters in passwords: they are embedded in the URLs below.

LOG_LEVEL=INFO

# Host ports, all bound to 127.0.0.1. Change one here if it is taken.
POSTGRES_PORT=5433
REDIS_PORT=6380
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
API_PORT=4100
GRAFANA_PORT=3101
JAEGER_UI_PORT=16687
PROMETHEUS_PORT=9091
OTEL_GRPC_PORT=4327
OTEL_HTTP_PORT=4328
TOXIPROXY_PORT=8475
TOXIPROXY_PROXY_PORTS=15433-15499

# Credentials for the compose services.
POSTGRES_USER=filinglens
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=filinglens
RABBITMQ_USER=filinglens
RABBITMQ_PASSWORD=change-me-rabbitmq
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# App settings for processes run on the host. Containers get service-name URLs from compose.
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}
REDIS_URL=redis://127.0.0.1:${REDIS_PORT}/0
BROKER_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@127.0.0.1:${RABBITMQ_PORT}//
# At least 32 characters. Only the web server holds it; the browser never sees it.
API_KEY=change-me-to-a-random-string-of-32-plus-characters
# Admin routes (ingest jobs) take only this key; it opens the normal routes too. At least 32
# characters, different from API_KEY. Keep it off the web server.
ADMIN_API_KEY=change-me-to-another-random-string-of-32-plus-chars
API_HOST=127.0.0.1
# Chunk embedding column that search reads: embedding (bge-small, model A) while dev stays at
# revision 0008 (make migrate REV=0008), embedding_v2 (bge-base) after the live swap. See
# docs/migrations.md.
RETRIEVAL_EMBEDDING_COLUMN=embedding
# Search reranks the fused top RERANK_CANDIDATES chunks (each cut to RERANK_MAX_TOKENS) with
# RERANK_MODEL; past RERANK_TIMEOUT_MS it keeps the fused order and says degraded.
RERANK_MODEL=cross-encoder/ms-marco-TinyBERT-L-2-v2
RERANK_CANDIDATES=50
RERANK_MAX_TOKENS=512
RERANK_TIMEOUT_MS=500
# Model calls are off unless AI_ENABLED=true; answers then return 503 once the day's (UTC) LLM
# tokens reach DAILY_AI_TOKEN_BUDGET, or past LLM_MAX_INFLIGHT answers in progress.
AI_ENABLED=false
DAILY_AI_TOKEN_BUDGET=1000000
# Claude's own tokens a UTC day, counted apart from the free models in the API's Redis database
# (the api and the evals share it): 1,500,000 costs at most $0.75 a day.
CLAUDE_DAILY_TOKEN_BUDGET=1500000
LLM_MAX_INFLIGHT=4
# Each sign-in's completed answers stay in Redis this long (60 to 28800 s), so the same question
# again answers from earlier; at most 10 per sign-in, cleared at sign-out.
RECENT_ANSWERS_TTL_S=1800
# Roles as provider:model (providers: gemini, groq, openrouter, nvidia, anthropic, ollama). With AI
# on, each role's provider needs its key below; Ollama needs only OLLAMA_URL.
LLM_PRIMARY=gemini:gemini-3.5-flash-lite
LLM_ROUTER=groq:openai/gpt-oss-20b
LLM_FALLBACK=nvidia:openai/gpt-oss-20b
# Answers only: tried after LLM_PRIMARY and before LLM_FALLBACK; empty keeps one answer model.
# Routing only, LLM_ROUTER_FALLBACK: tried after LLM_ROUTER and before LLM_FALLBACK.
# Production puts Claude first in both: LLM_PRIMARY and LLM_ROUTER anthropic:claude-haiku-5-5,
# LLM_ANSWER_FALLBACK Gemini and LLM_ROUTER_FALLBACK groq:openai/gpt-oss-20b (docs/deploy.md).
# Claude runs on prepaid credits and is skipped for good, in every process (Redis ai:claude:off),
# once they are gone (a 402, a 400 naming a spend limit), after a rejected key or model (401, 403,
# 404; alert ClaudeKeyOrModelRejected) and from ANTHROPIC_CREDITS_EXPIRE (UTC); a 429 hands only
# that call on. The models behind it stay free, so Claude cannot be LLM_ROUTER_FALLBACK,
# LLM_FALLBACK or LLM_JUDGE.
LLM_ANSWER_FALLBACK=
LLM_ROUTER_FALLBACK=
ANTHROPIC_CREDITS_EXPIRE=2026-11-10
# Evals only (make eval): the judge that scores citation precision and faithfulness, from another
# model family than LLM_PRIMARY. The API never reads it.
LLM_JUDGE=groq:openai/gpt-oss-120b
# Gemini: an AI Studio key, sent only in the x-goog-api-key header; GOOGLE_API_KEY is never read.
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434/v1
# Local models (embeddings, reranker) load from the Hugging Face cache in HF_HOME, set
# machine-wide here (H:\.cache\huggingface); `make models` fills it once, and containers mount it
# read-only and offline. Do not set HF_HOME here: an empty value would fall back to C:.

# SEC fair access: name your tool and give a real contact, such as "FilingLens Jane Doe
# jane.doe@mail.com". The ingest worker refuses to start with this placeholder.
SEC_USER_AGENT="FilingLens Your Name you@example.com"
# Raw SEC responses for processes run on the host (make seed-real), relative to the repo root.
# The ingest container mounts the same folder, so both share one cache on this disk.
SEC_CACHE_DIR=.cache/sec

# Web (web/): it reads only these, API_KEY, SESSION_SECRET and LOGIN_PASSWORD_HASH from this file,
# never ADMIN_API_KEY. Its server routes call API_URL; the browser never calls the API.
API_URL=http://127.0.0.1:4100
WEB_PORT=3100
# Not written here on purpose: `npm --prefix web run session-secret` appends SESSION_SECRET and
# refuses when a line exists (delete it to rotate; a new value signs everyone out), and
# `npm --prefix web run hash-password` prints LOGIN_PASSWORD_HASH='...' to paste, single quotes
# included, because compose and uv expand $.

# Lets plain `docker compose ...` work from the repo root; the Makefile passes -f itself.
COMPOSE_FILE=infra/docker-compose.yml
# Optional compose profiles, comma separated: observability, test.
COMPOSE_PROFILES=
# Telemetry (docs/monitoring.md): set it together with COMPOSE_PROFILES=observability, which
# starts the collector, Jaeger, Prometheus and Grafana, or leave both empty (off, no cost).
# Host runs export to http://127.0.0.1:${OTEL_HTTP_PORT}; compose gives the containers the
# collector's service URL whenever this is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
